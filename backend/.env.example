# Copy this to .env and fill in real keys when ready. Nothing needs to
# change in the code — search.py reads these through app/config.py and
# dispatches to the real provider automatically once the matching
# USE_MOCK_* flag is false.

USE_MOCK_FLIGHTS=true
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

USE_MOCK_HOTELS=true
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=

# Comma-separated list of allowed origins for CORS in production.
# Leave as * for local development.
CORS_ORIGINS=*
